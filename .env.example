# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/video_platform"

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_SECRET="replace_with_a_secure_256bit_random_secret"
JWT_EXPIRY="15m"
JWT_REFRESH_SECRET="replace_with_a_different_secure_secret"
JWT_REFRESH_EXPIRY="7d"

# ──────────────────────────────────────────────
# RAZORPAY (Test Mode — do NOT use production keys)
# ──────────────────────────────────────────────
RAZORPAY_KEY_ID="your_test_key_id"
RAZORPAY_KEY_SECRET="your_test_secret"

# ──────────────────────────────────────────────
# CLIENT / CORS
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:5000"
CLIENT_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ──────────────────────────────────────────────
# SMTP (for OTP emails)
# ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@yourplatform.com"

# ──────────────────────────────────────────────
# OTP SETTINGS
# ──────────────────────────────────────────────
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
